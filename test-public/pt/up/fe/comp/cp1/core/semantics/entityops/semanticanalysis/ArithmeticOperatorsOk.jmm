package pt.up.fe.comp.cp1.core.semantics.entityops.semanticanalysis;

class ArithmeticOperatorsOk {
    int arith(int a, int b, int c) {
        int r1;
        int r2;
        int r3;
        int r4;
        int r5;
        int r6;
        int r7;
        int r8;

        r1 = a + b + c;
        r2 = a - b - c;
        r3 = a * b * c;
        r4 = a / (b + 1);
        r5 = (r1 + r2) * (r3 - r4);
        r6 = (r5 / (a + 1)) + (r2 * r4);
        r7 = r1 - r2 + r3 - r4 + r5 - r6;
        r8 = (r7 * 2) / (r1 + r2 + 1);

        if (!(r8 < r7)) {
            r1 = r1 + 100;
            r2 = r2 * 2;
        } else {
            r3 = r3 - 50;
            r4 = r4 / 2;
        }

        r5 = (r1 * r2) - (r3 * r4) + (r7 / (r8 + 1));
        r6 = r5 + r1 - r2 + r3 - r4;

        if (!(r6 < 0)) {
            r7 = r6 * 2;
            r8 = r7 / (a + b + 1);
        } else {

        }

        r1 = r8 + r7 + r6 + r5 + r4 + r3 + r2 + r1;
        return r1;
    }
}