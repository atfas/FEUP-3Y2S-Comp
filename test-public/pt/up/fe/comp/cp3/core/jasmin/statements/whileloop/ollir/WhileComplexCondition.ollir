package pt.up.fe.comp.cp3.core.jasmin.statements.whileloop.ollir;

WhileComplexCondition extends Object  {
    
    .construct "<init>"().V {
        invokespecial(this."java.lang.Object", "<init>").V;
    }

    .method public method(limit.i32, otherCondition.bool).i32 {
        i.i32 :=.i32 0.i32;

    while0:
            tmp0.i32 :=.i32 limit.i32 *.i32 2.i32;
            tmp1.bool :=.bool i.i32 <.bool tmp0.i32;

            if (tmp1.bool) goto then0;
                andTmp0.bool :=.bool 0.bool;
                goto endif0;
        then0:

                andTmp0.bool :=.bool otherCondition.bool;
        endif0:
            if (!.bool andTmp0.bool) goto endwhile0;
            i.i32 :=.i32 i.i32 +.i32 1.i32;

            goto while0;
    endwhile0:

        ret.i32 i.i32;
    }

}
