package pt.up.fe.comp.cp3.core.jasmin.entitiesandops.logical.ollir;

LessThanComplexCalc extends Object  {
    
    .construct "<init>"().V {
        invokespecial(this."java.lang.Object", "<init>").V;
    }

    .method public method(b.i32).bool {
        tmp0.i32 :=.i32 b.i32 /.i32 2.i32;
        tmp1.i32 :=.i32 2.i32 *.i32 3.i32;
        tmp2.i32 :=.i32 b.i32 /.i32 tmp1.i32;
        tmp3.i32 :=.i32 tmp2.i32 +.i32 1.i32;
        tmp4.bool :=.bool tmp0.i32 <.bool tmp3.i32;
        a.bool :=.bool tmp4.bool;

        ret.bool a.bool;
    }

}
