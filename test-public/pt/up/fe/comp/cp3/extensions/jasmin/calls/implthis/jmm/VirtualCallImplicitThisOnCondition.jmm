package pt.up.fe.comp.cp3.extensions.jasmin.calls.implthis.jmm;

class VirtualCallImplicitThisOnCondition {

    public boolean isEmpty(int s) {
        return s < 1 && s > (0-1);
    }

    public int method(int s) {
        int a;
        if (isEmpty(s)) {
            a = 1;
        } else {
            a = 2;
        }
        a = a + 1;
        return a;
    }
}

