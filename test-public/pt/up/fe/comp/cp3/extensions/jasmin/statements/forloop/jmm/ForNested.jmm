package pt.up.fe.comp.cp3.extensions.jasmin.statements.forloop.jmm;

class ForNested {

    public int method(int n) {
        int i;
        int j;
        int res;
        res = 0;

        for (i = 0; i < n; i = i + 1) {
            for (j = 0; j < n; j = j + 1) {
                res = res + j + i;
            }
        }

        return res;
    }
}

