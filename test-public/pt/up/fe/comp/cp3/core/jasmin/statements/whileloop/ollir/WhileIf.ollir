    }

    .method public method(n.i32).i32 {
        i.i32 :=.i32 0.i32;

        res.i32 :=.i32 0.i32;

    while0:
            tmp0.bool :=.bool i.i32 <.bool n.i32;
            if (!.bool tmp0.bool) goto endwhile0;
            j.i32 :=.i32 i.i32 /.i32 2.i32;
            tmp2.i32 :=.i32 j.i32 *.i32 2.i32;
            tmp3.i32 :=.i32 i.i32 -.i32 tmp2.i32;
