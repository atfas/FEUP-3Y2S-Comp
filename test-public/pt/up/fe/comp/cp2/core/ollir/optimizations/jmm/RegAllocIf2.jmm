package pt.up.fe.comp.cp2.core.ollir.optimizations.jmm;

class RegAllocIf2 {
    public int method(int initB, int initC, int initE, int initF) {
        int a;
        int b;
        int c;
        int d;
        int i;
        b = initB;
        c = initC;
        a = b + c;
        d = initE + initF;
        d = d + initE;
        if (a == 0) {
            b = a - d;
        } else {
            b = a + d;
        }
        i = b;
        return i;
    }
}