package pt.up.fe.comp.cp3.core.jasmin.statements.whileloop.ollir;

WhileNested extends Object  {
    
    .construct "<init>"().V {
        invokespecial(this."java.lang.Object", "<init>").V;
    }

    .method public method(n.i32).i32 {
        i.i32 :=.i32 0.i32;

        j.i32 :=.i32 0.i32;

    while0:
            tmp0.bool :=.bool i.i32 <.bool n.i32;
            if (!.bool tmp0.bool) goto endwhile0;
        while1:
                tmp1.i32 :=.i32 i.i32 *.i32 n.i32;
                tmp2.bool :=.bool j.i32 <.bool tmp1.i32;
                if (!.bool tmp2.bool) goto endwhile1;
                j.i32 :=.i32 j.i32 +.i32 1.i32;

                goto while1;
        endwhile1:
            i.i32 :=.i32 i.i32 +.i32 1.i32;

            goto while0;
    endwhile0:

        ret.i32 j.i32;
    }

}
