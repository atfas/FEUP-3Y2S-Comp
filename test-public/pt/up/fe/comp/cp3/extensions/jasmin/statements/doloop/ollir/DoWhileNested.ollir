package pt.up.fe.comp.cp3.extensions.jasmin.statements.doloop.ollir;

DoWhileNested extends Object  {
    
    .construct "<init>"().V {
        invokespecial(this."java.lang.Object", "<init>").V;
    }

    .method public method(n.i32).i32 {
        i.i32 :=.i32 0.i32;

        j.i32 :=.i32 0.i32;

        res.i32 :=.i32 0.i32;

    while0:
        while1:
                j.i32 :=.i32 j.i32 +.i32 1.i32;
                tmp1.i32 :=.i32 res.i32 +.i32 j.i32;
                tmp2.i32 :=.i32 tmp1.i32 +.i32 i.i32;
                res.i32 :=.i32 tmp2.i32;
                tmp3.bool :=.bool j.i32 <.bool n.i32;
                if (tmp3.bool) goto while1;
                i.i32 :=.i32 i.i32 +.i32 1.i32;
                tmp5.bool :=.bool i.i32 <.bool n.i32;
                if (tmp5.bool) goto while0;

                ret.i32 res.i32;
            }

}
