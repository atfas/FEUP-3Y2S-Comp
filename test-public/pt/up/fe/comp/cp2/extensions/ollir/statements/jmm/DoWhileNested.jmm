package pt.up.fe.comp.cp2.extensions.ollir.statements.jmm;

class DoWhileNested {

    public int method(int n) {
        int i;
        int j;
        i = 0;
        j = 0;

        do {
            do {
                j = j + 1;
            } while (j < n);
            i = i + 1;
        } while (i < n);

        return i;
    }
}

