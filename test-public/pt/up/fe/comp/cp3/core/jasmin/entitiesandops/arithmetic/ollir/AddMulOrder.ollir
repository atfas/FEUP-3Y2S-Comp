package pt.up.fe.comp.cp3.core.jasmin.entitiesandops.arithmetic.ollir;

AddMulOrder extends Object  {
    
    .construct "<init>"().V {
        invokespecial(this."java.lang.Object", "<init>").V;
    }

    .method public method(b.i32).i32 {
        tmp0.i32 :=.i32 b.i32 *.i32 3.i32;
        tmp1.i32 :=.i32 1.i32 +.i32 tmp0.i32;
        a.i32 :=.i32 tmp1.i32;

        ret.i32 a.i32;
    }

}
