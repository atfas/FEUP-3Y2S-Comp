package pt.up.fe.comp.cp1.core.semantics.statements.semanticanalysis;

class ReturnSimpleOk {
    boolean something(boolean value) {
        int res;
        boolean cond;
        cond = true;
        if (value) {
            res = 1;
        } else {
            res = 0;
        }
        return cond;
    }
}