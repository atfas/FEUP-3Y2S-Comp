package pt.up.fe.comp.cp2.extensions.ollir.optimizations.jmm;

class BranchEliminationAndFalseTrue {

    public int foo(int trueValue, int falseValue) {
        int res;
        if (false && true) {
            res = trueValue;
        } else {
            res = falseValue;
        }
        return res;
    }

}
