package pt.up.fe.comp.cp2.extensions.ollir.optimizations.jmm;

class PropAndFoldingSequence {

    public int foo() {
        int a;
        int b;
        int c;
        int d;
        int e;

        a = 10;
        b = a + 20;
        c = 30 + b;
        d = c + 40;
        e = 50 + d;

        return e;
    }

}