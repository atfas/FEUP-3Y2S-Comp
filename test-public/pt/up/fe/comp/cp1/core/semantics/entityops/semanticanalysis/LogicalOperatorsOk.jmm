package pt.up.fe.comp.cp1.core.semantics.entityops.semanticanalysis;

class LogicalOperatorsOk {
    boolean logical(boolean p, boolean q, boolean r, int x, int y) {
        boolean c1;
        boolean c2;
        boolean c3;
        boolean c4;
        boolean c5;
        boolean c6;
        boolean c7;
        boolean c8;

        c1 = (x < y);
        c2 = !(x < y);
        c3 = p && q;
        c4 = !(!p && !r);
        c5 = !(c1 && c2) && (c3 && c4);
        c6 = !(!c5 && !(p && c1));
        c7 = !(!(x < 100) && !(y < 100));
        c8 = (c7 && !c6) && !(c4 && !c3);

        if (c1 && (c3 && !(c5 && !c8))) {
            p = !p;
            q = !q;
        } else {

        }

        if (!(c2 && c4) && !(!c6 && !c7)) {
            r = !r;
            c1 = !c1;
        } else {

        }

        c3 = !(!p && !(q && !r));
        c5 = !((x < y) && !(y < x));

        if (c8 && !(!c3 && !c5)) {
            c2 = !(c1 && c3);
            c4 = !(!c2 && !c8);
        } else {
            c6 = !(!c7 && !c1);
            c7 = !(c6 && c2);
        }

        p = !(c1 && c2) && !(c3 && c4) && !(c5 && c6) && !(c7 && c8);
        return p;
    }
}