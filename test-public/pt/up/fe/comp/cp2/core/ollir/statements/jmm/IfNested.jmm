package pt.up.fe.comp.cp2.core.ollir.statements.jmm;

class IfNested {

    public int method(boolean a, boolean b) {
        int res;
        if (a) {
            if (b) {
                res = 2;
            } else {
                res = 1;
            }
        } else {
            res = 0;
        }
        return res;
    }
}

